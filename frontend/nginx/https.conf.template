# Config HTTPS (usada quando o certificado Let's Encrypt existe).
# ${DOMAIN} é substituído pelo entrypoint via envsubst.
# 80 -> redireciona para HTTPS (mantendo o webroot do ACME para renovação).

# KL-160 — rate limiting na aplicação (independente do Cloudflare). ⚠️ Atrás do CF, $remote_addr é
# o IP da EDGE do Cloudflare (todos os usuários compartilhariam UM bucket → throttle global). A chave
# tem de ser o IP REAL do cliente = CF-Connecting-IP; acesso direto (sem CF) cai no $remote_addr da
# conexão. As zonas ficam NESTE arquivo (não num conf.d à parte) porque o `nginx -t` da CI monta só
# este config — uma zona externa ficaria indefinida e reprovaria o teste. Só um dos configs
# (http.conf OU https) é carregado por vez (entrypoint), então não há zona duplicada.
map $http_cf_connecting_ip $klarim_client_ip {
    default $http_cf_connecting_ip;
    ""      $remote_addr;
}
limit_req_zone $klarim_client_ip zone=general:10m rate=30r/s;
limit_req_zone $klarim_client_ip zone=api:10m rate=10r/s;
limit_req_zone $klarim_client_ip zone=scan:10m rate=2r/s;
limit_req_status 429;   # padrão do nginx é 503; a app quer 429 (Too Many Requests)

# KL-160 — bloqueia acesso via IP direto (sem passar pelo Cloudflare): SNI/Host que não casa nenhum
# server_name cai neste default_server. 443: rejeita o handshake TLS (sem cert, sem servir nada);
# 80: fecha a conexão (444). O CF conecta com SNI=${DOMAIN} → casa o server real abaixo, não este.
server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    return 444;
}
server {
    listen 443 ssl default_server;
    server_name _;
    server_tokens off;
    ssl_reject_handshake on;   # nginx ≥1.19.4 — recusa TLS de SNI desconhecido sem precisar de cert
}

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN} painel.${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# MTA-STS (RFC 8461): serve a policy em mta-sts.${DOMAIN}/.well-known/mta-sts.txt.
# O Cloudflare (proxy) faz o TLS voltado ao cliente; a origem responde nas duas portas
# para funcionar tanto em modo Flexible (CF -> origem :80) quanto Full (CF -> origem
# :443, com o cert do klarim.net). O TXT `_mta-sts.${DOMAIN}` (id da policy) é DNS —
# configurado pelo dono. NÃO redireciona 80->443 aqui (senão o modo Flexible quebra).
server {
    listen 80;
    server_name mta-sts.${DOMAIN};
    server_tokens off;
    location = /.well-known/mta-sts.txt {
        default_type text/plain;
        add_header Cache-Control "max-age=3600" always;
        alias /etc/nginx/klarim_mta-sts.txt;
    }
    location / { return 404; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name mta-sts.${DOMAIN};
    server_tokens off;
    # Reusa o cert do klarim.net (não cobre mta-sts.; o CF Full não valida o cert da
    # origem — Full strict exigiria expandir o cert com certbot -d mta-sts.${DOMAIN}).
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location = /.well-known/mta-sts.txt {
        default_type text/plain;
        add_header Cache-Control "max-age=3600" always;
        alias /etc/nginx/klarim_mta-sts.txt;
    }
    location / { return 404; }
}

server {
    # KL-160 — NÃO é mais o default_server: o SNI não-casado (IP direto) vai ao bloco de reject
    # acima. Este server responde só quando o SNI casa ${DOMAIN}/www (o Cloudflare envia esse SNI).
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security headers — o Klarim pratica o que prega (self-scan deve passar 100/100).
    include /etc/nginx/klarim_security_headers.conf;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;

    # KL-63 — OAuth 2.1 discovery (RFC 9728 / 8414). `^~` tem prioridade sobre o
    # `location ~ /\.` abaixo (que senão devolveria 404). Proxy IDENTIDADE (sem strip)
    # para a API, que serve os dois metadata na raiz. É a mesma máscara dos outros
    # blocos (server) — não afeta /api/, /mcp/ nem /painel/.
    location ^~ /.well-known/oauth- {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_api api:8000;
        proxy_pass http://$klarim_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # KL-65 — security.txt (RFC 9116). `location =` (exato) vence o `~ /\.` abaixo.
    location = /.well-known/security.txt {
        default_type "text/plain; charset=utf-8";
        add_header Cache-Control "public, max-age=86400" always;
        alias /etc/nginx/klarim_security.txt;
    }

    # Segurança (self-audit): paths sensíveis conhecidos retornam 404 em vez de
    # 200 com a SPA. Regex tem prioridade sobre os prefixos /assets/ e / abaixo,
    # mas não intercepta /api/ (sem ponto/extensão) nem as rotas /painel/.
    location ~ /\. { return 404; }                                            # .env .git .htaccess…
    location ~* \.(php|sql|bak|log|ya?ml|toml|ini|conf|config)$ { return 404; }
    location ~* ^/(phpinfo|server-status|server-info|wp-admin|wp-login|administrator|admin\.php) { return 404; }
    # Diretórios "suspeitos" que scanners sondam — 404 em vez de 200 com a SPA. NÃO
    # afeta /api/, /mcp/ (prefixos, e a âncora ^/ não casa /api/admin) nem /painel/.
    location ~* ^/(backup|uploads|admin|internal|debug|test|staging|tmp|temp|logs|private|secret|dump)(/|$) { return 404; }
    # KL-138 (hardening) — bloqueia MAIS paths de exploit ANTES do fallback SPA (que devolveria
    # 200+HTML → o scanner interpreta como endpoint ativo e intensifica). Complementa os blocos
    # acima (`.env`/`.git`/`.DS_Store`/`.htaccess`/`.htpasswd` já caem em `location ~ /\.`).
    location ~* ^/(wp-config|phpmyadmin|swagger|redoc|graphql|_debug|config\.(json|yml|php)|dump\.sql|database\.sql|xmlrpc\.php|cgi-bin|shell|eval-stdin|vendor/phpunit|actuator|api-docs|v[23]/api-docs) { return 404; }
    # KL-160 (URGENTE) — painéis de admin/debug que o bloco acima NÃO cobria: `/admin(/|$)` deixava
    # `/adminer` passar (vira SPA fallback → o Gate reportava admin_panel_exposed/debug_exposed
    # FALSO). Retorna 404 ANTES do fallback. Nenhuma rota pública/API começa por esses tokens.
    location ~* ^/(adminer|_profiler|phpMyAdmin|pma|dbadmin|sql|mysql|cpanel|webmail|roundcube|squirrelmail|horde|wp-content/debug) { return 404; }

    # KL-51 — nova plataforma pública (Astro): a raiz, as páginas institucionais/
    # legais, o favicon/robots e os assets do Astro vão ao container `astro`. O
    # RESTANTE (fluxo de scan, /painel, /assets) continua na SPA Vite (location /
    # abaixo). Resolver dinâmico + upstream em variável (mesmo motivo do /api/):
    # re-resolve o IP do `astro` a cada request, evitando 502 quando ele é recriado.
    location = / {
        limit_req zone=general burst=50 nodelay;   # KL-160 — 30r/s por IP real
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_astro astro:4321;
        proxy_pass http://$klarim_astro;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # add_header próprio (Cache-Control) quebra a herança — reinclui os de segurança.
        # A landing tem o formulário de scan → Cache-Control no-store (check_36).
        include /etc/nginx/klarim_security_headers.conf;
        add_header Cache-Control "no-store" always;
    }
    location ~ ^/(termos|privacidade|lgpd|cookies|sobre|contato|scan|cadastrar|entrar|confirmar|confirmado|recuperar-senha|dashboard|laudo|planos|favicon\.svg|robots\.txt|track\.js|theme\.js|header\.js|planos-auth\.js|landing-stats\.js|cookie-consent\.js|docs-copy\.js)(/|$) {
        limit_req zone=general burst=50 nodelay;   # KL-160
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_astro astro:4321;
        proxy_pass http://$klarim_astro;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Páginas com formulário (/scan, /contato, /entrar, /cadastrar…) → no-store (check_36).
        include /etc/nginx/klarim_security_headers.conf;
        add_header Cache-Control "no-store" always;
    }
    # KL-131 — sitemaps (index + sub-sitemaps) servidos pelo FastAPI (cache Redis 1h), NÃO
    # mais pelo Astro. Proxy SEM strip de prefixo (a rota é /sitemap*.xml na API, como
    # /remover). Casa /sitemap.xml, /sitemap-static.xml, /sitemap-sectors.xml,
    # /sitemap-profiles-N.xml. Content-Type application/xml vem do FastAPI; UM só Cache-Control
    # (antes o sitemap Astro emitia 2 — max-age 3600 do Astro + 300 do nginx).
    location ~ ^/sitemap[A-Za-z0-9._-]*\.xml$ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_api api:8000;
        proxy_pass http://$klarim_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/klarim_security_headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
    }
    # KL-133 — RSS do blog → FastAPI (sem strip de prefixo). `location =` (exato) vence a regex
    # do /blog Astro abaixo, então /blog/rss.xml vai à API e /blog/{slug} ao Astro.
    location = /blog/rss.xml {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_api api:8000;
        proxy_pass http://$klarim_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/klarim_security_headers.conf;
        add_header Cache-Control "public, max-age=1800" always;
    }
    # Perfis públicos SEO (KL-51 f4): /site/{dominio}, /score/{dominio} (redirect), os
    # rankings por setor (KL-42), a arquitetura de conteúdo (KL-74: /setores, /setor/{slug},
    # /melhores, /estatisticas) e o **blog** (KL-133: /blog, /blog/{slug}). Cacheáveis (sem
    # form) — cache curto. (O sitemap e o /blog/rss.xml saíram p/ o FastAPI.)
    location ~ ^/(site|score|ranking|setores|setor|melhores|estatisticas|metodologia|blog|security-gate|docs)(/|$) {
        limit_req zone=general burst=50 nodelay;   # KL-160
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_astro astro:4321;
        proxy_pass http://$klarim_astro;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        include /etc/nginx/klarim_security_headers.conf;
        add_header Cache-Control "public, max-age=300" always;
    }
    # KL-51 fase 1 — painel admin migrado para o Astro. SÓ as rotas já migradas vão ao
    # `astro`; as demais /painel/* continuam na SPA Vite (location / abaixo) — coexistência
    # sem regressão.
    # ⚠️ CSP: a CSP ESTRITA do site (script-src só 'self' + hashes) BLOQUEIA o bootstrap de
    # island do Astro (erro "Astro is not defined" → tela branca — verificado em produção).
    # /painel é operador-only, NOINDEX e não-linkado → NÃO é página pública pontuada pelo
    # self-scan (a home mantém a CSP estrita e o 100/100). Usamos aqui a MESMA CSP relaxada
    # do subdomínio painel. (script-src 'self' 'unsafe-inline'), que roda as ilhas. add_header
    # próprio quebra a herança → repetir os demais headers de segurança.
    # KL-51 fase 2: TODO o /painel migrado → `^/painel(/|$)` (App.jsx do Vite sem /painel).
    location ~ ^/painel(/|$) {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_astro astro:4321;
        proxy_pass http://$klarim_astro;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'" always;
        add_header Cache-Control "no-store" always;
    }
    location ^~ /_astro/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_astro astro:4321;
        proxy_pass http://$klarim_astro;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 1y;
        # add_header próprio quebra a herança dos headers do server — reincluir.
        include /etc/nginx/klarim_security_headers.conf;
        add_header Cache-Control "public, immutable";
    }

    location /assets/ {
        expires 1y;
        # add_header próprio quebra a herança dos headers do server — reincluir.
        include /etc/nginx/klarim_security_headers.conf;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA Vite (fluxo de scan existente + /painel). Fallback para o index.html.
    location / {
        limit_req zone=general burst=50 nodelay;   # KL-160 — navegação geral
        try_files $uri /index.html;
    }

    # KL-102 — /remover (descadastro RFC 8058): GET (página) + POST (form do browser E
    # one-click do Gmail/Yahoo) vão direto ao FastAPI, SEM strip de prefixo (a rota é
    # `/remover` na API). `location =` (exato) → não pega /removerXYZ. HTML utilitário
    # (estilos inline) → SEM a CSP estrita (como o /api/unsubscribe).
    location = /remover {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_api api:8000;
        proxy_pass http://$klarim_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # KL-138 — redirect curto dos e-mails (/a/{target_id}) → FastAPI, sem strip (a rota é /a/ na
    # API; registra o clique e faz 302 p/ /site/{domain}). `^/a/` não casa /assets//api/ (3º char).
    location ~ ^/a/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_api api:8000;
        proxy_pass http://$klarim_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # Proxy da API com resolver dinâmico (DNS do Docker) + upstream em variável:
    # o Nginx re-resolve o IP do `api` a cada request (TTL 10s) em vez de cachear
    # no boot. Evita o 502 quando o container `api` é recriado (novo IP) e o `web`
    # não (bug do login do painel). O rewrite faz o strip do prefixo /api/ (o
    # proxy_pass com variável não o faz automaticamente).
    # KL-160 — scans são pesados (rodam inline): zona `scan` mais restrita (2r/s, burst 5). Prefixo
    # mais longo que /api/ → casa /api/scan/* primeiro. Mesmo proxy/rewrite do /api/ abaixo.
    location /api/scan/ {
        limit_req zone=scan burst=5 nodelay;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_api api:8000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$klarim_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
    location /api/ {
        limit_req zone=api burst=20 nodelay;   # KL-160 — 10r/s por IP real (CF-Connecting-IP)
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_api api:8000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$klarim_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # KL-63 fix (CSP) — a página de login OAuth (/mcp/authorize) tem um <form> que POSTa
    # em 'self' e, ao autorizar, REDIRECIONA para o callback do cliente MCP (loopback ou
    # https). O `form-action 'self'` herdado do server bloqueava esse redirect. Location
    # dedicada (regex, vence o prefixo /mcp/) com CSP própria: form-action liberado p/
    # self + https + loopback. ⚠️ add_header próprio QUEBRA a herança dos headers do
    # server → re-declara os essenciais aqui. Aplica só às 3 rotas do fluxo OAuth; o
    # SSE (/mcp/sse, /mcp/messages/) continua no `location /mcp/` abaixo.
    location ~ ^/mcp/(authorize|token|register)(/|$) {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_api api:8000;
        proxy_pass http://$klarim_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self' https: http://localhost:* http://127.0.0.1:*" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # Streamable HTTP do MCP: o endpoint é /mcp/ (com barra). O /mcp "pelado" cairia
    # no location / (SPA) — redireciona para /mcp/ preservando a query (?token=).
    location = /mcp { return 308 /mcp/$is_args$args; }

    # Servidor MCP (KL-18) — Streamable HTTP (/mcp/) + SSE (/mcp/sse). Buffering/cache
    # DESLIGADOS + Connection '' obrigatórios. Mesmo resolver dinâmico. `access_log
    # off`: a auth pode vir em ?token= — não deve vazar nos logs. Identidade (sem rewrite).
    location /mcp/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $klarim_api api:8000;
        proxy_pass http://$klarim_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 300s;
        access_log off;
    }
}

# Subdomínio do painel (KL-14 → KL-106): painel.${DOMAIN} agora REDIRECIONA 301 para o domínio
# principal. O admin foi migrado para ${DOMAIN}/painel (Astro SSR); o subdomínio servia um build
# Vite ANTIGO desatualizado. O 301 preserva o path (painel.${DOMAIN}/painel/alvos →
# ${DOMAIN}/painel/alvos). Mesmo certificado (o SAN cobre painel.). Cookies de sessão vivem em
# ${DOMAIN} → re-login único no máximo, sem perda de dados.
server {
    listen 443 ssl;
    http2 on;
    server_name painel.${DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    return 301 https://${DOMAIN}$request_uri;
}
