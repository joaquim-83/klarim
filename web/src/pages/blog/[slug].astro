---
export const prerender = false; // SSR: busca o post por slug + SEO por página

import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PAGE_CONTAINER } from '../../lib/layout.js';
import { renderMarkdown, categoryLabel, formatBlogDate, sidebarLinks } from '../../lib/blog.js';

const SITE = 'https://klarim.net';
const API = process.env.KLARIM_API_URL || 'http://api:8000';
const slug = (Astro.params.slug || '').toLowerCase();

let post = null;
try {
  const res = await fetch(`${API}/blog/posts/${encodeURIComponent(slug)}`, {
    signal: AbortSignal.timeout(6000),
  });
  if (res.ok) post = await res.json();
} catch { /* API fora ou 404 → not found */ }

if (!post) Astro.response.status = 404;

const html = post ? renderMarkdown(post.content) : '';
const catLabel = post ? categoryLabel(post.category) : '';
const links = post ? sidebarLinks(post.category) : [];
const desc = post ? (post.meta_description || post.subtitle
  || `Análise de segurança web: ${post.title}.`) : '';

// Schema.org Article (KL-133) — tipo válido para conteúdo editorial.
const jsonLd = post ? {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: post.title,
  author: { '@type': 'Organization', name: 'Klarim', url: SITE },
  publisher: { '@type': 'Organization', name: 'Klarim' },
  datePublished: post.published_at,
  dateModified: post.updated_at,
  description: desc,
  ...(post.og_image_url ? { image: post.og_image_url } : {}),
} : undefined;
---

<Base
  title={post ? post.title : 'Artigo não encontrado'}
  fullTitleOverride={post ? `${post.title} | Blog Klarim` : undefined}
  description={desc || `Artigo do blog da Klarim.`}
  path={`/blog/${slug}`}
  ogType="article"
  ogImage={post && post.og_image_url ? post.og_image_url : undefined}
  jsonLd={jsonLd}
  noindex={!post}
>
  <Header />
  <main class={PAGE_CONTAINER}>
    {!post && (
      <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <h1 class="text-2xl font-bold text-white">Artigo não encontrado</h1>
        <p class="mt-3 text-slate-300">Este artigo não existe ou não está publicado.</p>
        <a href="/blog" class="mt-6 inline-block text-brand-400 hover:text-brand-300">← Ver o blog</a>
      </div>
    )}

    {post && (
      <div class="lg:flex lg:gap-10">
        <article class="min-w-0 lg:flex-1">
          <nav aria-label="Trilha" class="flex flex-wrap items-center gap-x-1.5 text-sm text-slate-500">
            <a href="/blog" class="hover:text-brand-300">Blog</a>
            <span class="text-slate-700">→</span>
            <span class="text-slate-400">{catLabel}</span>
            <span class="text-slate-700">→</span>
            <span class="truncate text-slate-400">{post.title}</span>
          </nav>

          <span class="mt-4 inline-flex rounded-full bg-brand-500/15 px-2.5 py-0.5 text-xs font-semibold text-brand-400">{catLabel}</span>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">{post.title}</h1>
          {post.subtitle && <p class="mt-2 text-lg text-slate-400">{post.subtitle}</p>}
          <p class="mt-4 border-b border-slate-800 pb-6 text-sm text-slate-500">
            Por {post.author} · {formatBlogDate(post.published_at)} · {post.reading_time_min} min de leitura
          </p>

          <div class="blog-prose mt-6" set:html={html} />

          <section class="mt-12 rounded-2xl border border-brand-500/30 bg-brand-500/10 p-6 text-center">
            <h3 class="text-xl font-bold text-white">Verifique a segurança do seu site</h3>
            <p class="mt-1 text-slate-300">Análise gratuita de 48 pontos em 30 segundos.</p>
            <a href="/scan" class="mt-4 inline-flex min-h-[44px] items-center rounded-xl bg-brand-500 px-6 py-3 text-base font-semibold text-[var(--accent-text)] hover:bg-brand-400">
              Verificar agora →
            </a>
          </section>
        </article>

        <aside class="mt-10 shrink-0 lg:mt-0 lg:w-64">
          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 lg:sticky lg:top-6">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Veja também</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {links.map((l) => (
                <li><a href={l.href} class="text-brand-400 hover:text-brand-300">{l.label}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    )}
  </main>
  <Footer />
</Base>

<style>
  /* Estilos do conteúdo markdown renderizado (scoped → bundlado, CSP-safe). */
  .blog-prose :global(h2) { font-size: 1.5rem; font-weight: 700; color: #fff; margin: 1.75rem 0 0.75rem; }
  .blog-prose :global(h3) { font-size: 1.25rem; font-weight: 600; color: #fff; margin: 1.5rem 0 0.5rem; }
  .blog-prose :global(p) { color: #cbd5e1; line-height: 1.75; margin: 0.75rem 0; }
  .blog-prose :global(a) { color: #ff8a5c; text-decoration: underline; }
  .blog-prose :global(ul), .blog-prose :global(ol) { color: #cbd5e1; margin: 0.75rem 0 0.75rem 1.25rem; list-style: disc; }
  .blog-prose :global(ol) { list-style: decimal; }
  .blog-prose :global(li) { margin: 0.35rem 0; }
  .blog-prose :global(strong) { color: #fff; }
  .blog-prose :global(blockquote) { border-left: 3px solid #475569; padding-left: 1rem; color: #94a3b8; margin: 1rem 0; }
  .blog-prose :global(code) { background: #1e293b; padding: 0.15rem 0.35rem; border-radius: 0.25rem; font-size: 0.9em; }
  .blog-prose :global(pre) { background: #0f172a; border: 1px solid #1e293b; border-radius: 0.5rem; padding: 1rem; overflow-x: auto; margin: 1rem 0; }
  .blog-prose :global(pre code) { background: transparent; padding: 0; }
  .blog-prose :global(img) { max-width: 100%; border-radius: 0.5rem; margin: 1rem 0; }
  .blog-prose :global(table) { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
  .blog-prose :global(th), .blog-prose :global(td) { border: 1px solid #334155; padding: 0.5rem 0.75rem; text-align: left; color: #cbd5e1; }
  .blog-prose :global(th) { background: #1e293b; color: #fff; }
  .blog-prose :global(hr) { border-color: #1e293b; margin: 2rem 0; }
</style>
