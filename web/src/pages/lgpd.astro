---
export const prerender = false; // SSR — a ilha do form roda no cliente e lê o ?tipo= da URL

// KL-161 — canal de direitos do titular (LGPD/DSAR). Público, sem conta: qualquer pessoa exerce
// seus direitos (acesso, correção, exclusão, portabilidade, revogação). O form envia a
// POST /api/lgpd/request (registro + confirmação por e-mail). Prazo legal: até 15 dias úteis.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LGPDForm from '../components/lgpd/LGPDForm.jsx';
import { FORM_CONTAINER } from '../lib/layout.js';
---

<Base
  title="Seus direitos (LGPD)"
  description="Exerça seus direitos de titular de dados pessoais (LGPD): acesso, correção, exclusão, portabilidade e revogação de consentimento. Prazo de resposta: até 15 dias úteis."
  path="/lgpd"
>
  <Header />
  <main class={FORM_CONTAINER}>
    <div class="mb-6">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Seus direitos (LGPD)</h1>
      <p class="mt-3 text-slate-300">
        A Lei Geral de Proteção de Dados (LGPD) garante a você o controle sobre os seus dados
        pessoais. Use o formulário abaixo para solicitar acesso, correção, exclusão, portabilidade
        ou revogar um consentimento. Atendemos em <strong class="text-white">até 15 dias úteis</strong>.
      </p>
      <p class="mt-2 text-sm text-slate-400">
        Encarregado de Proteção de Dados (DPO):
        <a href="mailto:privacidade@klarim.net" class="text-brand-400 hover:text-brand-300">privacidade@klarim.net</a>.
        Veja também a <a href="/privacidade" class="text-brand-400 hover:text-brand-300">Política de Privacidade</a>.
      </p>
    </div>

    <LGPDForm client:load />
  </main>
  <Footer />
</Base>
