---
export const prerender = true;
// KL-134 P2 — índice das 5 micro-ferramentas gratuitas de segurança web (landing de aquisição).
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PAGE_CONTAINER } from '../../lib/layout.js';
import { TOOLS } from '../../lib/tools.js';

const SITE = 'https://klarim.net';
const ITEMLIST_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ferramentas gratuitas de segurança web da Klarim',
  itemListElement: TOOLS.map((t, i) => ({
    '@type': 'ListItem', position: i + 1, name: t.name, url: `${SITE}${t.path}`,
  })),
};
---
<Base
  title="Ferramentas gratuitas de segurança web"
  fullTitleOverride="Ferramentas gratuitas de segurança web | Klarim"
  description="5 ferramentas gratuitas para verificar a segurança do seu site: SSL, headers, LGPD, tecnologias e email. Sem cadastro."
  path="/ferramentas"
  jsonLd={ITEMLIST_JSONLD}
>
  <Header />
  <main class={PAGE_CONTAINER}>
    <div class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">Ferramentas Gratuitas</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
        Verifique a segurança do seu site em segundos. Sem cadastro, sem custo — resultado completo na hora.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-5 sm:grid-cols-2">
      {TOOLS.map((t) => (
        <a href={t.path}
          class="group flex flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition-colors hover:border-brand-500/50 hover:bg-slate-900">
          <div class="text-3xl" aria-hidden="true">{t.icon}</div>
          <h2 class="mt-3 text-lg font-bold text-white">{t.name}</h2>
          <p class="mt-1 flex-1 text-sm text-slate-400">{t.short}</p>
          <span class="mt-4 inline-flex min-h-[44px] items-center text-sm font-semibold text-brand-400 group-hover:underline">
            Verificar →
          </span>
        </a>
      ))}
    </div>

    <div class="mx-auto mt-14 max-w-2xl rounded-2xl border border-brand-500/40 bg-brand-500/10 p-6 text-center">
      <p class="text-white">Quer a análise completa? São <strong>86 verificações</strong> num único relatório.</p>
      <a href="/scan"
        class="mt-4 inline-flex min-h-[48px] w-full items-center justify-center rounded-xl bg-brand-500 px-6 text-base font-semibold text-[var(--accent-text)] transition-colors hover:bg-brand-400 sm:w-auto">
        Verificar meu site — completo e gratuito →
      </a>
    </div>
  </main>
  <Footer />
</Base>
