---
// KL-135 — banner de consentimento (LGPD). HTML estático (sem inline script → CSP-safe); a
// lógica (mostrar/ocultar, gravar cookie, carregar GA4 SÓ com opt-in) fica em /cookie-consent.js.
// Começa `hidden`; o JS o revela na 1ª visita (sem cookie `klarim_consent`). Theme-aware (KL-87):
// os utilitários slate invertem juntos, então bg escuro + texto claro funcionam nos 2 temas.
---
<div id="cookie-banner" hidden aria-label="Consentimento de cookies" role="region"
  class="fixed inset-x-0 bottom-0 z-[60] border-t border-slate-800 bg-slate-900/95 backdrop-blur px-4 py-4 shadow-2xl sm:px-6">
  <div class="mx-auto flex max-w-5xl flex-col gap-3">
    <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-slate-300">
        🍪 Usamos cookies para melhorar sua experiência. Ao aceitar, você concorda com a nossa
        <a href="/cookies" class="text-brand-400 underline hover:text-brand-300">Política de Cookies</a>.
        Os cookies de analytics só carregam com o seu consentimento.
      </p>
      <div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto sm:flex-row">
        <button type="button" data-cc="accept"
          class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-[var(--accent-text)] transition-colors hover:bg-brand-400 active:scale-[0.98] sm:w-auto">Aceitar todos</button>
        <button type="button" data-cc="configure"
          class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 transition-colors hover:bg-slate-800 sm:w-auto">Configurar</button>
        <button type="button" data-cc="reject"
          class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg px-4 py-2 text-sm font-medium text-slate-400 transition-colors hover:text-white sm:w-auto">Recusar</button>
      </div>
    </div>

    <!-- Painel de configuração (expandido pelo botão "Configurar"). -->
    <div id="cc-config" hidden class="mt-1 border-t border-slate-800 pt-3">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Preferências de cookies</p>
      <div class="mt-3 space-y-3">
        <label class="flex items-start gap-3 text-sm">
          <input type="checkbox" checked disabled class="mt-0.5 h-4 w-4 accent-brand-500" />
          <span><span class="font-medium text-slate-200">Essenciais</span> <span class="text-slate-500">(sempre ativo)</span><br />
            <span class="text-xs text-slate-500">Sessão de login, tema e sua preferência de consentimento.</span></span>
        </label>
        <label class="flex items-start gap-3 text-sm">
          <input type="checkbox" id="cc-analytics" class="mt-0.5 h-4 w-4 accent-brand-500" />
          <span><span class="font-medium text-slate-200">Analytics</span><br />
            <span class="text-xs text-slate-500">Google Analytics — nos ajuda a entender como o site é usado.</span></span>
        </label>
        <label class="flex items-start gap-3 text-sm opacity-60">
          <input type="checkbox" disabled class="mt-0.5 h-4 w-4 accent-brand-500" />
          <span><span class="font-medium text-slate-200">Marketing</span><br />
            <span class="text-xs text-slate-500">Nenhum ativo no momento.</span></span>
        </label>
      </div>
      <div class="mt-4">
        <button type="button" data-cc="save"
          class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 transition-colors hover:bg-slate-800">Salvar preferências</button>
      </div>
    </div>
  </div>
</div>

<style>
  #cookie-banner[data-open] { animation: cc-slide-up 0.3s ease; }
  @keyframes cc-slide-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
</style>
