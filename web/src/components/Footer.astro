---
import Logo from './Logo.astro';
const year = 2026;
// Footer em seções (fix header/footer): Produto · Desenvolvedores · Empresa & Legal.
// "Security Gate" e "Documentação" ficam agrupados em Desenvolvedores (saíram do header principal).
const groups = [
  {
    title: 'Produto',
    links: [
      { href: '/scan', label: 'Pesquisar site' },
      { href: '/setores', label: 'Setores' },
      { href: '/melhores', label: 'Melhores' },
      { href: '/estatisticas', label: 'Estatísticas' },
      { href: '/blog', label: 'Blog' },
    ],
  },
  {
    title: 'Desenvolvedores',
    links: [
      { href: '/security-gate', label: 'Security Gate' },
      { href: '/docs/gate/github-actions', label: 'Documentação' },
    ],
  },
  {
    title: 'Empresa & Legal',
    links: [
      { href: '/sobre', label: 'Sobre' },
      { href: '/contato', label: 'Contato' },
      { href: '/metodologia', label: 'Metodologia' },
      { href: '/privacidade', label: 'Privacidade' },
      { href: '/termos', label: 'Termos de Uso' },
      { href: '/cookies', label: 'Cookies' },
    ],
  },
];
---

<footer class="border-t border-slate-800 bg-slate-950 px-5 py-12" style="contain:layout">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col items-center gap-3 text-center">
      <Logo />
      <p class="text-sm text-slate-400">Segurança web para o Brasil.</p>
    </div>

    <div class="mx-auto mt-10 grid max-w-3xl grid-cols-1 gap-8 text-center sm:grid-cols-3 sm:text-left">
      {groups.map((g) => (
        <div>
          <h3 class="mb-3 text-xs font-bold uppercase tracking-wide text-slate-500">{g.title}</h3>
          <ul class="space-y-2">
            {g.links.map((l) => (
              <li><a href={l.href} class="text-sm text-slate-400 transition-colors hover:text-white">{l.label}</a></li>
            ))}
            {g.title === 'Empresa & Legal' && (
              <li>
                {/* KL-135: reabre o banner de consentimento (o /cookie-consent.js escuta [data-cc]). */}
                <button type="button" data-cc="reopen" class="text-sm text-slate-400 transition-colors hover:text-white">Preferências de cookies</button>
              </li>
            )}
          </ul>
        </div>
      ))}
    </div>

    <p class="mx-auto mt-10 max-w-md text-center text-xs leading-relaxed text-slate-600">
      © {year} Klarim. Scanner 100% passivo — analisa apenas o que o site já entrega
      publicamente. Nenhum dado privado é coletado.
    </p>
  </div>
</footer>
