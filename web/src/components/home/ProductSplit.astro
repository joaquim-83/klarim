---
// KL-153 P2 — seção da home separando os DOIS produtos (empresa × dev), com linguagem distinta.
// Astro puro (SSG, sem JS). Aparece abaixo do hero (scroll-down); o hero segue sendo a 1ª tela.
import { PRODUCT_CARDS } from '../../lib/nav.js';
---
<section class="border-t border-slate-800 bg-slate-950/40 px-5 py-14 sm:py-20">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-center text-2xl font-bold text-white sm:text-3xl">Dois produtos, um só lugar</h2>
    <p class="mt-2 text-center text-sm text-slate-400">Escolha o caminho certo para o seu objetivo.</p>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {PRODUCT_CARDS.map((c) => (
        <div id={c.id} class="flex scroll-mt-24 flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-6 shadow-sm sm:p-8">
          <span class="text-3xl" aria-hidden="true">{c.icon}</span>
          <h3 class="mt-4 text-xl font-bold text-white">{c.title}</h3>
          <p class="mt-2 text-sm text-slate-300">{c.subtitle}</p>
          <div class="mt-6">
            <a href={c.href}
              class="inline-flex min-h-[48px] w-full items-center justify-center rounded-xl bg-brand-500 px-5 text-base font-semibold text-[var(--accent-text)] transition-colors hover:bg-brand-400 active:scale-95 sm:w-auto">
              {c.cta} →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
